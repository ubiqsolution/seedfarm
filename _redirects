# Cloudflare Pages redirects / rewrites
# Syntax: https://developers.cloudflare.com/pages/configuration/redirects/
#
# Status codes:
#   200 = rewrite (URL stays clean in the address bar)
#   301 = permanent redirect (browser URL changes)

# Note: /terms and /privacy are NOT listed here. Cloudflare Pages already serves
# them natively via its built-in clean-URL behavior (auto-strips .html). Adding an
# explicit /terms -> /terms.html rewrite would cause an infinite redirect loop
# because CF then 308s /terms.html back to /terms.

/sitemap        /sitemap.xml        200

# Convenience aliases for LLM/AEO discovery
/llms           /llms.txt           200
/ai.txt         /llms.txt           200
/llms-full      /llms-full.txt      200

# robots.txt convenience (some scanners try /robots without extension)
/robots         /robots.txt         200

# Force 404 for internal docs that get accidentally requested.
# Without this, CF Pages' SPA fallback returns index.html with 200 OK,
# causing Google to index these URLs (GSC: "Indexed, though blocked by robots.txt").
# These files are gitignored and never deployed, but the URL paths still need a hard 404.
/AGENTS.md      /404                404
/CLAUDE.md      /404                404
